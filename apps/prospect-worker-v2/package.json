{
  "name": "prospect-worker-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FadeUp Prospect Worker V2 — deterministic barbershop/barber discovery, enrichment, deduplication and scoring worker. PostgreSQL-backed job queue, no Redis.",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint"
  },
  "dependencies": {
    "nodemailer": "^9.0.5",
    "pg": "^8.13.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "oxlint": "^1.75.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
