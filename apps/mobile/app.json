{
  "expo": {
    "name": "FadeUp",
    "slug": "fadeup",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fadeup",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F8F7",
        "foregroundImage": "./assets/images/icon.png"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F8F7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FadeUp utilise votre position uniquement pour la recherche « Autour de moi » et pour vérifier votre présence au salon quand vous rejoignez une file."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FadeUp utilise la caméra uniquement pour scanner le QR affiché dans le salon."
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}