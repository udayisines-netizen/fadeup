{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./infra/supabase/.env)",
      "Read(/opt/jasmean-os/**)",
      "Edit(/opt/jasmean-os/**)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/security-guard.py"
          }
        ]
      }
    ]
  }
}
