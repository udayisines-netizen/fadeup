# FadeUp ops — configuration d'exécution. À copier vers ~/ops/.env (jamais
# dans git : ce fichier-ci est le modèle, le vrai contient la clé Resend).
#
# install.sh crée ~/ops/.env automatiquement en extrayant RESEND_API_KEY de
# infra/supabase/.env ; ne remplir à la main que pour changer un défaut.

# --- alertes (obligatoire) ---------------------------------------------------
# Clé API Resend (la même que celle du vault applicatif ; restreinte à l'envoi).
RESEND_API_KEY=re_xxxxxxxxxxxx
# Destinataire des alertes.
ALERT_EMAIL=fondateur@example.com
# Expéditeur — doit rester sur le seul domaine vérifié chez Resend.
ALERT_FROM="FadeUp Ops <ops@contact.fade-up.com>"
# Rappel d'une alerte persistante, en secondes (défaut 24 h).
#ALERT_REPEAT_SECONDS=86400

# --- sauvegardes -------------------------------------------------------------
# Racine locale des sauvegardes automatiques (gitignorée via backups/).
#BACKUP_ROOT=/opt/fadeup/backups/auto
# Fichier contenant la passphrase GPG (généré par install.sh, chmod 600).
# LE FONDATEUR DOIT EN GARDER UNE COPIE HORS SERVEUR — voir README.md §2.
#BACKUP_PASSPHRASE_FILE=~/ops/backup.passphrase
# Taille minimale acceptée d'un dump, en octets (garde-fou anti-troncature).
#BACKUP_MIN_BYTES=1000000

# --- copie hors serveur (à activer quand le fondateur fournit les clés) ------
# Remote rclone au format <nom>:<bucket>/<préfixe>. Tant que vide, backup.sh
# garde les copies locales et envoie un rappel hebdomadaire.
# Exemple après configuration de ~/.config/rclone/rclone.conf :
#BACKUP_REMOTE=fadeup-offsite:fadeup-backups/prod
BACKUP_REMOTE=

# --- supervision -------------------------------------------------------------
# Dead-man externe (README §3) : si ce ping cesse, healthchecks.io alerte.
#HEALTHCHECKS_PING_URL=https://hc-ping.com/<uuid>
#DISK_ALERT_PCT=80
#MEM_MIN_MB=250
#HEARTBEAT_MAX_AGE=300
#BACKUP_MAX_AGE_H=26
#TLS_MIN_DAYS=14
#TLS_HOST=fade-up.com
# Liste des conteneurs attendus, séparés par des espaces. fadeup-prospect-worker-v2
# n'y est pas : il est arrêté volontairement (Exited 0) au moment de X1 —
# l'ajouter ici le jour où il doit tourner en continu.
#EXPECTED_CONTAINERS="fadeup-supabase-db fadeup-supabase-kong ..."

# --- chemins -----------------------------------------------------------------
# Repo de production (fournit probe_public_rpcs.sh et l'ANON_KEY).
#FADEUP_REPO=/opt/fadeup
#OPS_STATE_DIR=~/ops/state
