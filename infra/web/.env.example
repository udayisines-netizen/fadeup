# FadeUp web — build-time configuration.
#
# Copy to infra/web/.env and fill in. That file is gitignored.
#
# Both values are PUBLIC by construction: every visitor's browser receives
# them. The anon key is safe to publish precisely because it grants nothing
# on its own — every tenant table is RLS-protected and every privileged
# operation goes through a SECURITY DEFINER RPC that re-checks the caller.
#
# NEVER put a service_role key, an SMTP password, or a Google/Apple client
# secret in this file. Those are server-side only: GoTrue holds the provider
# secrets (infra/supabase/.env) and the worker holds its own credentials.

# The origin the BROWSER uses to reach Supabase.
#
# Must be HTTPS and same-origin with the site for two reasons:
#   1. A page served over HTTPS cannot call an http:// API — browsers block
#      it as active mixed content, so every request silently fails.
#   2. Google and Apple both refuse a plain-HTTP or raw-IP OAuth redirect
#      URI, and GoTrue derives that URI from its own API_EXTERNAL_URL, which
#      must agree with this value.
#
# Requires the host nginx to proxy /auth/v1/, /rest/v1/, /storage/v1/ and
# /realtime/v1/ to Kong — see infra/web/nginx-host-fadeup.conf.example.
VITE_SUPABASE_URL=https://fadeup.jasmean.com

# The anon / publishable key from infra/supabase/.env (ANON_KEY).
VITE_SUPABASE_ANON_KEY=

# Optional. Set to a spare port (e.g. 15181) to stage a cutover before
# taking over the port the live site is served from.
# FADEUP_WEB_PORT=15180
