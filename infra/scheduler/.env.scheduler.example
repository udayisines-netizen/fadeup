# FadeUp booking scheduler — copy to infra/scheduler/.env.scheduler (gitignored).
#
# The role holds EXECUTE on public.run_booking_maintenance() and NOTHING else:
# no table privileges, no other function. Even a leaked password cannot read an
# appointment.
#
# Create it and set the password once, as postgres:
#
#   alter role fadeup_scheduler login password '<generated>';
#
# (The migration creates the role NOLOGIN — a password in a migration would be
# a password in git.)

PGHOST=db
PGPORT=5432
PGDATABASE=postgres
PGUSER=fadeup_scheduler
PGPASSWORD=

# How often to sweep. 60s is comfortably finer than the shortest allowed
# decision window (15 minutes), so a slot is never held meaningfully longer
# than its deadline.
SCHEDULER_INTERVAL_SECONDS=60
