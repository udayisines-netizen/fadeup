# FadeUp Prospect Worker V2 — environment template.
# Copy to infra/worker/.env.worker and fill in real values. That file is
# gitignored and must NEVER be committed. See docs/worker-v2/operations.md.

NODE_ENV=production

WORKER_NAME=prospect-worker-v2
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=5000

# Direct Postgres connection (NOT PostgREST) as the dedicated prospect_worker
# role — see db/migrations/20260811150100_prospect_acquisition_schema.sql
# and infra/worker/bootstrap-worker-db.sh.
DB_HOST=fadeup-supabase-db
DB_PORT=5432
DB_NAME=postgres
DB_USER=prospect_worker
DB_PASSWORD=

# Every key below is OPTIONAL. An empty value gracefully disables that
# source/adapter — it does not block the Worker from starting or running
# other sources. See docs/worker-v2/sources.md and api-quotas.md.
GOOGLE_PLACES_API_KEY=
GEOAPIFY_API_KEY=
INSEE_API_KEY=
META_ACCESS_TOKEN=
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=

OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

GOOGLE_MAX_REQUESTS_PER_MINUTE=20
GEOAPIFY_MAX_REQUESTS_PER_SECOND=5
OVERPASS_MAX_CONCURRENT_REQUESTS=2
INSEE_MAX_CONCURRENT_REQUESTS=2

DEFAULT_COUNTRY=FR
DEFAULT_LOCALE=fr-FR
