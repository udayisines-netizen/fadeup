# FadeUp Prospect Worker V2 — environment template.
# Copy to infra/worker/.env.worker and fill in real values. That file is
# gitignored and must NEVER be committed. See docs/worker-v2/operations.md.

NODE_ENV=production

WORKER_NAME=prospect-worker-v2
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=5000

# Direct Postgres connection (NOT PostgREST) as the dedicated prospect_worker
# role — see db/migrations/20260811150100_prospect_acquisition_schema.sql
# and infra/worker/bootstrap-worker-db.sh.
DB_HOST=fadeup-supabase-db
DB_PORT=5432
DB_NAME=postgres
DB_USER=prospect_worker
DB_PASSWORD=

# Every key below is OPTIONAL. An empty value gracefully disables that
# source/adapter — it does not block the Worker from starting or running
# other sources. See docs/worker-v2/sources.md and api-quotas.md.
GOOGLE_PLACES_API_KEY=
GEOAPIFY_API_KEY=
INSEE_API_KEY=
META_ACCESS_TOKEN=
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=

OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

GOOGLE_MAX_REQUESTS_PER_MINUTE=20
GEOAPIFY_MAX_REQUESTS_PER_SECOND=5
OVERPASS_MAX_CONCURRENT_REQUESTS=2
INSEE_MAX_CONCURRENT_REQUESTS=2

DEFAULT_COUNTRY=FR
DEFAULT_LOCALE=fr-FR

# ============================================================================
# WhatsApp Business Cloud API (official Meta platform only)
# ============================================================================
# Every key below is OPTIONAL. With no access token present, whatsapp_accounts
# rows fall back to the MOCK provider: the whole outreach pipeline runs and
# recipients advance through the funnel, but nothing is sent to any real
# number and message ids are prefixed wamid.MOCK.
#
# There is no browser-automation or reverse-engineered fallback, and there
# never will be. See docs/worker-v2/whatsapp.md.

# Meta System User access token with whatsapp_business_messaging +
# whatsapp_business_management. Server-side only — NEVER a VITE_* variable.
META_WHATSAPP_ACCESS_TOKEN=

# Meta App secret. Used to validate the X-Hub-Signature-256 header on
# inbound webhooks. Without it, webhook envelopes are STORED for forensics
# but never processed.
META_APP_SECRET=

# An arbitrary high-entropy string you choose. Echoed back during Meta's
# webhook subscription challenge; must match what you enter in the Meta
# App dashboard.
META_WEBHOOK_VERIFY_TOKEN=

META_GRAPH_API_VERSION=v23.0
WHATSAPP_REQUEST_TIMEOUT_MS=15000
WHATSAPP_SEND_BATCH_SIZE=25

# ============================================================================
# Webhook HTTP listener
# ============================================================================
# Disabled by default: the Worker is a pure outbound process unless you
# explicitly turn this on. When enabled it binds inside the container
# network and is meant to sit behind the existing Nginx TLS terminator —
# never exposed to the Internet directly.
WEBHOOK_HTTP_ENABLED=false
WEBHOOK_HTTP_PORT=8088
WEBHOOK_HTTP_HOST=0.0.0.0
WEBHOOK_PATH=/webhooks/whatsapp

# ============================================================================
# Machine learning
# ============================================================================
# Where ml/train.py writes model artifacts and where inference reads them.
# Inference REFUSES any registry artifact_path outside this directory.
ML_ARTIFACT_DIR=/app/ml-artifacts
ML_MODEL_CACHE_TTL_MS=300000

# ============================================================================
# Website enrichment crawler
# ============================================================================
CRAWLER_MAX_PAGES_PER_DOMAIN=8
CRAWLER_MAX_DEPTH=2
CRAWLER_TOTAL_TIMEOUT_MS=45000
